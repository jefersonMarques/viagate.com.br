package pages

import (
	"github.com/viagate/site/internal/site"
	"github.com/viagate/site/web/components"
)

templ Solution(meta site.PageMeta, solution site.Solution) {
	@components.Layout(meta) {
		<section class="solution-command-hero">
			<div class="command-grid" aria-hidden="true"></div>
			<div class="command-glow command-glow-right" aria-hidden="true"></div>
			<div class="container solution-command-grid">
				<div class="solution-command-copy">
					<nav class="breadcrumb breadcrumb-dark" aria-label="Navegação estrutural"><a href="/">Início</a><span>/</span><a href="/solucoes">Soluções</a><span>/</span><span>{ solution.ShortName }</span></nav>
					<div class="product-overline"><span></span>{ solution.Name }</div>
					<h1>{ solution.Title }</h1>
					<p>{ solution.Lead }</p>
					<div class="hero-actions">
						<a class="button" href={ "/contato?interesse=" + solution.Slug }>Agendar uma demonstração</a>
						<a class="button button-dark-ghost" href="#como-funciona">Ver o processo</a>
					</div>
					<div class="solution-command-proof">
						<div>
							<span>
								@components.Icon(solution.Features[0].Icon)
							</span>
							<p><small>CAPACIDADE</small><strong>{ solution.Features[0].Title }</strong></p>
						</div>
						<div>
							<span>
								@components.Icon(solution.Features[3].Icon)
							</span>
							<p><small>DIFERENCIAL</small><strong>{ solution.Features[3].Title }</strong></p>
						</div>
					</div>
				</div>
				if solution.Slug == "pesquisa-cadastral-de-motoristas" {
					@components.CargoScoreNetworkPanel()
				} else {
					@components.SolutionSignalPanel(solution)
				}
			</div>
		</section>
		<section class="solution-positioning">
			<div class="container solution-positioning-intro">
				<span class="eyebrow">Definição objetiva</span>
				<h2>O que é { solution.ShortName }</h2>
				<p>{ solution.Definition }</p>
			</div>
			<div class="container solution-positioning-grid">
				<article>
					<span>01 / INDICADO PARA</span>
					<h3>Quem utiliza</h3>
					<p>{ solution.Audience }</p>
				</article>
				<article>
					<span>02 / PROBLEMA</span>
					<h3>O que precisa mudar</h3>
					<p>{ solution.Challenge }</p>
				</article>
				<article>
					<span>03 / RESULTADO</span>
					<h3>O que a operação ganha</h3>
					<p>{ solution.Outcome }</p>
				</article>
			</div>
		</section>
		<section class="section solution-capabilities">
			<div class="container solution-capabilities-heading">
				<div><span class="eyebrow">Capacidades essenciais</span><h2>{ solution.SectionTitle }</h2></div>
				<p>{ solution.SectionText }</p>
			</div>
			<div class="container solution-feature-grid">
				for index, feature := range solution.Features {
					<article class="solution-feature-card">
						<div class="solution-feature-top">
							<span>
								@components.Icon(feature.Icon)
							</span><small>0{ index + 1 }</small>
						</div>
						<h3>{ feature.Title }</h3>
						<p>{ feature.Text }</p>
					</article>
				}
			</div>
		</section>
		if solution.Slug == "pesquisa-cadastral-de-motoristas" {
			<section id="como-funciona" class="solution-process score-process-section">
				<div class="container solution-process-heading score-process-heading">
					<div><span class="product-overline"><span></span> Fluxo cadastral / 04 etapas</span><h2>{ solution.ProcessTitle }</h2></div>
					<p>{ solution.ProcessText }</p>
				</div>
				<div class="container score-process-shell" data-score-process>
					<div class="score-process-livebar">
						<span><i></i> FLUXO CADASTRAL ATIVO</span>
						<strong data-score-process-state>Solicitação recebida</strong>
						<small data-score-process-counter>01 / 04</small>
					</div>
					<ol class="score-process-track">
						<li class="is-active" data-score-process-step data-step-state="Solicitação recebida" data-step-detail={ solution.Steps[0].Text }>
							<div class="score-process-node"><span>@components.Icon("send")</span><small>01</small></div>
							<div><small>INPUT / 01</small><h3>{ solution.Steps[0].Title }</h3><p>{ solution.Steps[0].Text }</p></div>
							<i class="score-process-step-state" aria-hidden="true"></i>
						</li>
						<li data-score-process-step data-step-state="Consentimento em andamento" data-step-detail={ solution.Steps[1].Text }>
							<div class="score-process-node"><span>@components.Icon("link")</span><small>02</small></div>
							<div><small>IDENTITY / 02</small><h3>{ solution.Steps[1].Title }</h3><p>{ solution.Steps[1].Text }</p></div>
							<i class="score-process-step-state" aria-hidden="true"></i>
						</li>
						<li data-score-process-step data-step-state="Análise em processamento" data-step-detail={ solution.Steps[2].Text }>
							<div class="score-process-node"><span>@components.Icon("database")</span><small>03</small></div>
							<div><small>ENGINE / 03</small><h3>{ solution.Steps[2].Title }</h3><p>{ solution.Steps[2].Text }</p></div>
							<i class="score-process-step-state" aria-hidden="true"></i>
						</li>
						<li data-score-process-step data-step-state="Resultado disponível" data-step-detail={ solution.Steps[3].Text }>
							<div class="score-process-node"><span>@components.Icon("user-check")</span><small>04</small></div>
							<div><small>OUTPUT / 04</small><h3>{ solution.Steps[3].Title }</h3><p>{ solution.Steps[3].Text }</p></div>
							<i class="score-process-step-state" aria-hidden="true"></i>
						</li>
					</ol>
					<div class="score-process-footer">
						<div class="score-process-current"><small>ESTADO ATUAL</small><strong data-score-process-detail>{ solution.Steps[0].Text }</strong></div>
						<div class="score-process-meter" aria-hidden="true"><span data-score-process-meter></span></div>
						<span class="score-process-percent" data-score-process-percent>25%</span>
					</div>
				</div>
			</section>
		} else {
			<section id="como-funciona" class="solution-process">
				<div class="container solution-process-heading">
					<div><span class="product-overline"><span></span> Processo em movimento</span><h2>{ solution.ProcessTitle }</h2></div>
					<p>{ solution.ProcessText }</p>
				</div>
				<div class="container process-live-bar" aria-hidden="true">
					<span><i></i> PROCESSO ATIVO</span>
					<strong>VIAGATE / { solution.ShortName }</strong>
					<small>04 ETAPAS CONECTADAS</small>
				</div>
				<ol class="container solution-process-grid">
					for index, step := range solution.Steps {
						<li>
							<div class="process-step-marker">
								<span>
									@components.Icon(solution.Features[index].Icon)
								</span>
								<small>0{ index + 1 }</small>
							</div>
							<div><small>ETAPA 0{ index + 1 }</small><h3>{ step.Title }</h3><p>{ step.Text }</p></div>
							<i class="process-step-status" aria-hidden="true"></i>
						</li>
					}
				</ol>
			</section>
		}
		<section class="section solution-evidence">
			<div class="container solution-evidence-grid">
				<div class="solution-evidence-copy">
					<span class="eyebrow">Resultado visível</span>
					<h2>{ solution.EvidenceTitle }</h2>
					<p>{ solution.Summary }</p>
					<p>{ solution.Outcome }</p>
					<a class="button button-outline" href={ "/contato?interesse=" + solution.Slug }>Solicitar uma demonstração</a>
				</div>
				@components.ImagePlaceholder(solution.SecondaryImage, solution.SecondarySize, "solution-evidence-image")
			</div>
		</section>
		<section class="section faq-section">
			<div class="container faq-layout">
				<div><span class="eyebrow">Dúvidas frequentes</span><h2>Perguntas sobre { solution.ShortName }</h2></div>
				<div class="faq-list">
					for _, item := range solution.FrequentlyAsked {
						<details>
							<summary>{ item.Question }<span>+</span></summary>
							<p>{ item.Answer }</p>
						</details>
					}
				</div>
			</div>
		</section>
		@components.CallToAction("Veja "+solution.ShortName+" aplicado ao seu processo", "Agende uma demonstração para discutir fluxo, integrações, critérios e formato de contratação.")
	}
}
