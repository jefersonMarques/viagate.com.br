package pages

import (
	"github.com/viagate/site/internal/site"
	"github.com/viagate/site/web/components"
)

templ About(meta site.PageMeta) {
	@components.Layout(meta) {
		<section class="page-hero">
			<div class="container hero-grid">
				<div class="hero-copy"><span class="eyebrow">Sobre a Viagate</span><h1>Tecnologia brasileira para decisões críticas no transporte</h1><p class="hero-lead">Conectamos identidade, pesquisa cadastral, prevenção e logística para transformar dados dispersos em processos rastreáveis.</p></div>
				@components.AboutCoreVisual()
			</div>
		</section>
		<section class="section">
			<div class="container split-content">
				<div><span class="eyebrow">Nossa perspectiva</span><h2>Uma decisão não termina quando o cadastro é aprovado</h2><p>A identidade influencia a contratação. A autenticação protege etapas sensíveis. Os eventos da viagem preservam o contexto da decisão inicial.</p><p>Por isso, a Viagate desenvolve produtos modulares que resolvem problemas específicos e podem compartilhar informações dentro de uma operação integrada.</p></div>
				@components.AboutContinuityVisual()
			</div>
		</section>
		<section class="section section-muted">
			<div class="container values-grid">
				<article><span>01</span><h2>Clareza</h2><p>Informação compreensível para decisões humanas e processos auditáveis.</p></article>
				<article><span>02</span><h2>Integração</h2><p>Tecnologia que se adapta ao fluxo, sem criar ilhas operacionais.</p></article>
				<article><span>03</span><h2>Responsabilidade</h2><p>Segurança, privacidade e finalidade consideradas desde o desenho da solução.</p></article>
				<article><span>04</span><h2>Evolução</h2><p>Produtos modulares preparados para acompanhar novas necessidades.</p></article>
			</div>
		</section>
		@components.CallToAction("Veja a tecnologia Viagate em funcionamento", "Agende uma demonstração para conhecer os produtos e discutir o seu cenário operacional.")
	}
}
