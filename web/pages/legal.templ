package pages

import (
	"github.com/a-h/templ"
	"github.com/viagate/site/internal/site"
	"github.com/viagate/site/web/components"
)

templ Legal(meta site.PageMeta, documentHTML string) {
	@components.Layout(meta) {
		<article class="legal-document-page">
			<header class="legal-document-hero" id="termos-de-uso">
				<div class="command-grid" aria-hidden="true"></div>
				<div class="container legal-document-hero-inner">
					<nav class="breadcrumb breadcrumb-dark" aria-label="Navegação estrutural"><a href="/">Início</a><span>/</span><span>Termos de uso e Política de privacidade</span></nav>
					<div class="product-overline"><span></span> DOCUMENTO OFICIAL / VIA GATEWAY</div>
					<h1>Termos de Uso e Política de Privacidade</h1>
					<p class="legal-document-version">Revista e em vigor desde 29/01/2021.</p>
					<div class="legal-document-hero-meta" aria-label="Informações do documento">
						<div><small>EMPRESA</small><strong>VIA GATEWAY LTDA.</strong></div>
						<div><small>APLICAÇÕES</small><strong>Cargo Truck / Score / Consulta Avulsa</strong></div>
						<div><small>FORO</small><strong>Curitiba / Paraná</strong></div>
					</div>
				</div>
			</header>

			<div class="container legal-document-layout">
				<aside class="legal-document-sidebar" aria-label="Índice do documento">
					<div class="legal-document-sidebar-inner">
						<span>ÍNDICE / DOCUMENTO</span>
						<a href="#termos-de-uso">Termos de uso</a>
						<a href="#utilizacao-do-sistema-cargo-truck">Cargo Truck</a>
						<a href="#utilizacao-no-sistema-score-pesquisa-cadastral">Score</a>
						<a href="#utilizacao-no-sistema-consulta-avulsa-biometria">Consulta avulsa</a>
						<a href="#politica-de-privacidade">Política de privacidade</a>
						<a href="#quais-dados-sao-coletados">Dados coletados</a>
						<a href="#compartilhamento-de-informacoes-pessoais-com-terceiros">Compartilhamento</a>
						<a href="#como-armazenamos-as-informacoes-coletadas">Armazenamento</a>
						<a href="#controle-das-informacoes-pessoais">Controle dos dados</a>
						<a href="#encarregado-do-tratamento-dos-dados">Encarregado</a>
					</div>
				</aside>

				<div class="legal-document-content">
					@templ.Raw(documentHTML)
				</div>
			</div>
		</article>
	}
}
