package pages

import (
	"github.com/viagate/site/internal/site"
	"github.com/viagate/site/web/components"
)

templ Home(meta site.PageMeta, solutions []site.Solution, articles []site.Article) {
	@components.Layout(meta) {
		<section class="command-hero">
			<div class="command-grid" aria-hidden="true"></div>
			<div class="command-glow command-glow-left" aria-hidden="true"></div>
			<div class="command-glow command-glow-right" aria-hidden="true"></div>
			<div class="container command-hero-grid">
				<div class="command-copy">
					<div class="authority-line">
						<span class="authority-dot"></span>
						Tecnologia para decisões críticas no transporte
					</div>
					<h1>Controle o risco <span>antes que ele alcance a operação.</span></h1>
					<p>Da biometria ao histórico cadastral e veicular, a Viagate reúne os sinais críticos de motoristas, veículos e viagens para sua equipe decidir com mais velocidade, padrão e evidências.</p>
					<div class="hero-actions">
						<a class="button" href="/contato">Agendar uma demonstração</a>
						<a class="button button-dark-ghost" href="/solucoes">Conheça as soluções</a>
					</div>
					<ul class="command-principles" aria-label="Princípios da plataforma">
						<li><span>01</span> Sinais reunidos</li>
						<li><span>02</span> Políticas aplicadas</li>
						<li><span>03</span> Decisão rastreável</li>
					</ul>
				</div>
				@components.CommandCenter()
			</div>
			<div class="container command-capabilities">
				<div><span>Identidade</span><strong>Biometria e prova de vida</strong></div>
				<div><span>Decisão</span><strong>Pesquisa e critérios operacionais</strong></div>
				<div><span>Proteção</span><strong>Autenticação contra fraudes</strong></div>
				<div><span>Operação</span><strong>Viagens, eventos e integrações</strong></div>
			</div>
		</section>
		<section class="insurer-trust" aria-labelledby="insurer-trust-title">
			<div class="container insurer-trust-inner">
				<div class="insurer-trust-heading">
					<div>
						<span>Confiança no ecossistema segurador</span>
						<h2 id="insurer-trust-title">Seguradoras que confiam na Viagate</h2>
					</div>
					<p>Relacionamentos construídos em operações que exigem segurança, rastreabilidade e capacidade de resposta.</p>
				</div>
				<div class="insurer-logo-grid" role="list" aria-label="Seguradoras clientes da Viagate">
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/Mapfre_logo.svg" width="160" height="56" alt="Mapfre" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/Swiss_Re_2013_logo.svg" width="160" height="56" alt="Swiss Re" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/akad-logo.svg" width="160" height="56" alt="Akad Seguros" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/allianz-logo.svg" width="160" height="56" alt="Allianz" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/axa-logo.svg" width="160" height="56" alt="AXA" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/berkley-logo.svg" width="160" height="56" alt="Berkley" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/chubb-logo.svg" width="160" height="56" alt="Chubb" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/ff-logo.svg" width="160" height="56" alt="FF Seguros" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/hdi-seguros-logo.svg" width="160" height="56" alt="HDI Seguros" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/liberty-seguros.svg" width="160" height="56" alt="Liberty Seguros" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/porto-seguro-logo.svg" width="160" height="56" alt="Porto Seguro" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/sura_logo.svg" width="160" height="56" alt="Sura" decoding="async"/></div>
					<div class="insurer-logo" role="listitem"><img src="/assets/images/Insurancers/white/tokiomarine-logo.svg" width="160" height="56" alt="Tokio Marine" decoding="async"/></div>
				</div>
			</div>
		</section>
		<section class="flagship-section">
			<div class="flagship-noise" aria-hidden="true"></div>
			<div class="container flagship-grid">
				<div class="flagship-copy">
					<span class="product-overline"><span></span> Plataforma Cargo / Cargo Score</span>
					<h2>Todos os sinais críticos antes da decisão cadastral.</h2>
					<p>O Cargo Score reúne biometria, telefone, CNH, ANTT, processos, dados veiculares e regras configuradas para cada operação.</p>
					<ul class="flagship-list">
						<li>
							<span>
								@components.Icon("scan-face")
							</span>
							<div><strong>Presença e identidade</strong><small>Biometria facial e prova de vida dentro do fluxo.</small></div>
						</li>
						<li>
							<span>
								@components.Icon("sliders")
							</span>
							<div><strong>Política operacional</strong><small>Critérios compatíveis com cada perfil de operação.</small></div>
						</li>
						<li>
							<span>
								@components.Icon("history")
							</span>
							<div><strong>Contexto preservado</strong><small>Status, reanálise e histórico para revisão.</small></div>
						</li>
					</ul>
					<a class="button" href="/solucoes/pesquisa-cadastral-de-motoristas">Conhecer o Cargo Score</a>
				</div>
				@components.BiometricCore()
			</div>
		</section>
		<section class="section control-statement">
			<div class="container control-statement-grid">
				<div>
					<span class="eyebrow">Visão integrada de risco</span>
					<h2>Uma jornada conectada, da identidade à viagem.</h2>
				</div>
				<div class="control-statement-copy">
					<p>Biometria, cadastros, autenticação e eventos logísticos deixam de ser verificações isoladas e passam a compartilhar contexto.</p>
					<a class="text-link text-link-large" href="/sobre">Conheça a visão Viagate <span aria-hidden="true">→</span></a>
				</div>
			</div>
			<div class="container risk-chain" aria-label="Cadeia de controle operacional">
				<div>
					<span class="risk-index">01</span>
					<div class="risk-icon">
						@components.Icon("scan-face")
					</div>
					<h3>Confirmar</h3>
					<p>Identidade e presença antes de autorizar a jornada.</p>
				</div>
				<div>
					<span class="risk-index">02</span>
					<div class="risk-icon">
						@components.Icon("user-check")
					</div>
					<h3>Analisar</h3>
					<p>Dados e critérios reunidos com origem e finalidade.</p>
				</div>
				<div>
					<span class="risk-index">03</span>
					<div class="risk-icon">
						@components.Icon("shield-check")
					</div>
					<h3>Proteger</h3>
					<p>Autenticação adicional nos momentos mais sensíveis.</p>
				</div>
				<div>
					<span class="risk-index">04</span>
					<div class="risk-icon">
						@components.Icon("route")
					</div>
					<h3>Acompanhar</h3>
					<p>Eventos e viagem conectados à decisão inicial.</p>
				</div>
			</div>
		</section>
		<section class="section audience-section">
			<div class="container ecosystem-heading">
				<div><span class="eyebrow">Aplicação por operação</span><h2>Tecnologia para quem precisa decidir e responder.</h2></div>
				<p>As mesmas capacidades assumem papéis diferentes conforme a responsabilidade de cada empresa no transporte.</p>
			</div>
			<div class="container audience-grid">
				<article>
					<span>
						@components.Icon("shield-check")
					</span>
					<small>SEGURADORAS</small>
					<h3>Critérios e evidências para políticas de risco</h3>
					<p>Organize validações e preserve o contexto necessário para análise e revisão.</p>
				</article>
				<article>
					<span>
						@components.Icon("user-check")
					</span>
					<small>GERENCIADORAS DE RISCO</small>
					<h3>Pesquisa, autenticação e acompanhamento conectados</h3>
					<p>Reúna etapas críticas sem perder a origem e a continuidade da operação.</p>
				</article>
				<article>
					<span>
						@components.Icon("truck")
					</span>
					<small>TRANSPORTADORAS E EMBARCADORES</small>
					<h3>Cadastros e viagens com menos conferência dispersa</h3>
					<p>Padronize verificações e acompanhe atividades dentro de um processo rastreável.</p>
				</article>
				<article>
					<span>
						@components.Icon("code")
					</span>
					<small>EMPRESAS DE SOFTWARE</small>
					<h3>Capacidades incorporadas ao produto atual</h3>
					<p>Integre validações por API ou ofereça jornadas com experiência white label.</p>
				</article>
			</div>
		</section>
		<section class="section ecosystem-section">
			<div class="container ecosystem-heading">
				<div><span class="eyebrow">Ecossistema modular</span><h2>Soluções para cada ponto crítico da operação.</h2></div>
				<p>Comece pelo problema prioritário e conecte novas capacidades sem reconstruir o processo.</p>
			</div>
			<div class="container power-grid">
				for index, solution := range solutions {
					@components.PowerSolutionCard(solution, index+1)
				}
			</div>
			<div class="container ecosystem-action"><a class="button button-outline" href="/solucoes">Ver todo o ecossistema</a></div>
		</section>
		<section class="section enterprise-control">
			<div class="container enterprise-control-grid">
				@components.ImagePlaceholder("Painel real da Plataforma Cargo mostrando validação cadastral, alertas, fontes consultadas, mapa da operação e trilha de auditoria.", "1920 x 1280 px - proporção 3:2", "enterprise-control-image")
				<div class="enterprise-control-copy">
					<span class="eyebrow">Decisões documentadas</span>
					<h2>Cada decisão deixa uma trilha clara.</h2>
					<p>Origem, critérios, mudanças de status e eventos essenciais permanecem organizados para análise, reanálise e auditoria.</p>
					<div class="control-points">
						<div><span>01</span><p><strong>Origem identificada</strong>Informações vinculadas às fontes aplicáveis.</p></div>
						<div><span>02</span><p><strong>Critério visível</strong>Regras e status compreensíveis para a equipe.</p></div>
						<div><span>03</span><p><strong>Trilha preservada</strong>Eventos essenciais registrados para auditoria.</p></div>
					</div>
				</div>
			</div>
		</section>
		<section class="integration-section">
			<div class="container integration-grid">
				<div class="integration-copy">
					<span class="product-overline"><span></span> Integrações via API</span>
					<h2>Biometria e consultas dentro do seu software.</h2>
					<p>Integre validações, cadastros e informações operacionais aos sistemas já utilizados pela equipe.</p>
					<div class="integration-tags"><span>REST</span><span>JSON</span><span>Webhooks</span><span>White label</span></div>
					<a class="button button-light" href="/integracoes/api">Conhecer as APIs</a>
				</div>
				@components.ApiConsole()
			</div>
		</section>
		<section class="section knowledge-section">
			<div class="container knowledge-heading">
				<div><span class="eyebrow">Inteligência aplicada</span><h2>Conteúdo para decisões que não aceitam improviso.</h2></div>
				<a class="text-link text-link-large" href="/blog">Acessar central de conteúdo <span aria-hidden="true">→</span></a>
			</div>
			<div class="container article-grid">
				for _, article := range articles {
					@components.ArticleCard(article)
				}
			</div>
		</section>
		@components.CallToAction("Veja como a Viagate se encaixa na sua operação", "Agende uma demonstração para mapear riscos, produtos e integrações aplicáveis ao seu cenário.")
	}
}
