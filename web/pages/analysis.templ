package pages

import (
	"fmt"

	"github.com/viagate/site/internal/site"
	"github.com/viagate/site/web/components"
)

templ Analyses(meta site.PageMeta, analyses []site.AnalysisReference) {
	@components.Layout(meta) {
		<section class="analysis-index-hero">
			<div class="command-grid" aria-hidden="true"></div>
			<div class="container analysis-index-hero-inner">
				<nav class="breadcrumb breadcrumb-dark" aria-label="Navegação estrutural"><a href="/">Início</a><span>/</span><span>Tipos de análises</span></nav>
				<div class="product-overline"><span></span> BASE DE REFERÊNCIA / VIAGATE</div>
				<h1>Tipos de análises para transporte e gestão de riscos</h1>
				<p>Entenda o papel de cada verificação dentro de processos de identidade, pesquisa cadastral, prevenção veicular e acompanhamento operacional. Cada página explica o que a análise significa, o que pode considerar e quais são seus limites.</p>
			</div>
		</section>

		<section class="analysis-index-intro">
			<div class="container analysis-index-intro-grid">
				<div><span class="eyebrow">Como usar este conteúdo</span><h2>Uma referência por tema, sem misturar produto e análise.</h2></div>
				<p>As páginas abaixo descrevem conceitos e usos operacionais. A disponibilidade de fontes, campos, integrações e critérios depende do produto e do escopo contratado.</p>
			</div>
		</section>

		@AnalysisCategory("01 / IDENTIDADE", "Pessoa", "Verificações ligadas à identidade, presença, cadastro e contexto de quem participa da operação.", analyses, "Identidade")
		@AnalysisCategory("02 / DOCUMENTOS E RISCO", "Risco", "Informações documentais e critérios usados para contextualizar a pesquisa cadastral e apoiar decisões operacionais.", analyses, "Documentos e risco")
		@AnalysisCategory("03 / OPERAÇÃO E VEÍCULO", "Veículo", "Registros do veículo, pendências, monitoramento e eventos que ajudam a reconstruir o contexto da operação.", analyses, "Operação e veículo")

		@components.CallToAction("Precisa combinar diferentes tipos de análise?", "Converse com a Viagate para entender quais capacidades fazem sentido para a finalidade e o fluxo da sua operação.")
	}
}

templ AnalysisCategory(code string, title string, description string, analyses []site.AnalysisReference, category string) {
	<section class="analysis-index-category">
		<div class="container analysis-index-category-heading">
			<div><span>{ code }</span><h2>{ title }</h2></div>
			<p>{ description }</p>
		</div>
		<div class="container analysis-index-grid">
			for index, analysis := range analyses {
				if analysis.Category == category {
					<a class="analysis-index-card" href={ "/analises/" + analysis.Slug }>
						<div class="analysis-index-card-top"><span>@components.Icon(analysis.Icon)</span><small>{ fmt.Sprintf("REF / %02d", index+1) }</small></div>
						<h3>{ analysis.Name }</h3>
						<p>{ analysis.MetaDescription }</p>
						<strong>Consultar referência <span aria-hidden="true">→</span></strong>
					</a>
				}
			}
		</div>
	</section>
}

templ Analysis(meta site.PageMeta, analysis site.AnalysisReference, related []site.AnalysisReference) {
	@components.Layout(meta) {
		<article class="analysis-reference-page">
			<header class="analysis-reference-hero">
				<div class="command-grid" aria-hidden="true"></div>
				<div class="container analysis-reference-hero-grid">
					<div class="analysis-reference-hero-copy">
						<nav class="breadcrumb breadcrumb-dark" aria-label="Navegação estrutural"><a href="/">Início</a><span>/</span><a href="/analises">Tipos de análises</a><span>/</span><span>{ analysis.Name }</span></nav>
						<div class="product-overline"><span></span> { analysis.Category } / { analysis.Subject }</div>
						<h1>{ analysis.Title }</h1>
						<p>{ analysis.Lead }</p>
					</div>
					<aside class="analysis-reference-facts" aria-label="Resumo da análise">
						<div class="analysis-reference-facts-head"><span>@components.Icon(analysis.Icon)</span><strong>{ analysis.Name }</strong></div>
						<dl>
							<div><dt>Categoria</dt><dd>{ analysis.Category }</dd></div>
							<div><dt>Objeto</dt><dd>{ analysis.Subject }</dd></div>
							<div><dt>Finalidade</dt><dd>Apoiar contexto e decisão operacional</dd></div>
							<div><dt>Solução relacionada</dt><dd>{ analysis.RelatedSolutionName }</dd></div>
						</dl>
					</aside>
				</div>
			</header>

			<section class="analysis-reference-definition" aria-labelledby="analysis-definition-title">
				<div class="container analysis-reference-content-grid">
					<div class="analysis-reference-section-label"><span>01</span><small>DEFINIÇÃO</small></div>
					<div class="analysis-reference-prose">
						<span class="eyebrow">Resposta direta</span>
						<h2 id="analysis-definition-title">O que é { analysis.Name }?</h2>
						<p class="analysis-reference-lead">{ analysis.Definition }</p>
						<p>{ analysis.Purpose }</p>
					</div>
				</div>
			</section>

			<section class="analysis-reference-scope" aria-labelledby="analysis-scope-title">
				<div class="container analysis-reference-content-grid">
					<div class="analysis-reference-section-label"><span>02</span><small>ESCOPO</small></div>
					<div class="analysis-reference-prose">
						<h2 id="analysis-scope-title">O que esta análise pode considerar?</h2>
						<ul class="analysis-reference-list">
							for _, item := range analysis.Scope {
								<li>{ item }</li>
							}
						</ul>
					</div>
				</div>
			</section>

			<section class="analysis-reference-process" aria-labelledby="analysis-process-title">
				<div class="container analysis-reference-content-grid">
					<div class="analysis-reference-section-label"><span>03</span><small>PROCESSO</small></div>
					<div class="analysis-reference-prose">
						<h2 id="analysis-process-title">Como entra no processo operacional?</h2>
						<ol class="analysis-reference-process-list">
							for index, item := range analysis.Process {
								<li><span>{ fmt.Sprintf("%02d", index+1) }</span><p>{ item }</p></li>
							}
						</ol>
					</div>
				</div>
			</section>

			<section class="analysis-reference-interpretation" aria-labelledby="analysis-interpretation-title">
				<div class="container analysis-reference-content-grid">
					<div class="analysis-reference-section-label"><span>04</span><small>INTERPRETAÇÃO</small></div>
					<div class="analysis-reference-prose">
						<h2 id="analysis-interpretation-title">Como interpretar o resultado?</h2>
						<div class="analysis-interpretation-grid">
							<div class="analysis-interpretation-primary"><small>O QUE O RESULTADO AJUDA A ENTENDER</small><p>{ analysis.Interpretation }</p></div>
							<div class="analysis-interpretation-limits"><small>LIMITES IMPORTANTES</small><ul>
								for _, item := range analysis.Limitations {
									<li>{ item }</li>
								}
							</ul></div>
						</div>
					</div>
				</div>
			</section>

			<section class="analysis-reference-product" aria-labelledby="analysis-product-title">
				<div class="container analysis-reference-product-card">
					<div><span>05 / APLICAÇÃO NA VIAGATE</span><h2 id="analysis-product-title">Onde esta análise aparece no ecossistema Viagate?</h2><p>Esta referência explica o conceito. A aplicação prática, as fontes disponíveis e a configuração dependem da solução e do escopo contratado.</p></div>
					<a class="button button-outline" href={ analysis.RelatedSolutionPath }>Conhecer { analysis.RelatedSolutionName }</a>
				</div>
			</section>

			<section class="analysis-reference-faq faq-section" aria-labelledby="analysis-faq-title">
				<div class="container faq-layout">
					<div><span class="eyebrow">Dúvidas frequentes</span><h2 id="analysis-faq-title">Perguntas sobre { analysis.Name }</h2></div>
					<div class="faq-list">
						for _, item := range analysis.FrequentlyAsked {
							<details><summary>{ item.Question }<span>+</span></summary><p>{ item.Answer }</p></details>
						}
					</div>
				</div>
			</section>

			if len(related) > 0 {
				<section class="analysis-related" aria-labelledby="analysis-related-title">
					<div class="container analysis-related-heading"><div><span class="eyebrow">Mesmo grupo</span><h2 id="analysis-related-title">Outras análises relacionadas</h2></div><a class="text-link" href="/analises">Ver todos os tipos <span aria-hidden="true">→</span></a></div>
					<div class="container analysis-related-grid">
						for _, item := range related {
							<a href={ "/analises/" + item.Slug }><span>@components.Icon(item.Icon)</span><small>{ item.Category }</small><strong>{ item.Name }</strong><i aria-hidden="true">→</i></a>
						}
					</div>
				</section>
			}
		</article>
	}
}
