package components

import "github.com/viagate/site/internal/site"

templ Layout(meta site.PageMeta) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<meta name="description" content={ meta.Description }/>
			<link rel="canonical" href={ meta.Canonical }/>
			if meta.NoIndex {
				<meta name="robots" content="noindex, follow"/>
			} else {
				<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"/>
			}
			<meta property="og:locale" content="pt_BR"/>
			<meta property="og:site_name" content="Viagate"/>
			<meta property="og:type" content={ meta.Type }/>
			<meta property="og:title" content={ meta.Title }/>
			<meta property="og:description" content={ meta.Description }/>
			<meta property="og:url" content={ meta.Canonical }/>
			<meta property="og:image" content={ meta.Image }/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ meta.Title }/>
			<meta name="twitter:description" content={ meta.Description }/>
			<meta name="twitter:image" content={ meta.Image }/>
			<meta name="theme-color" content="#071527"/>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<link rel="manifest" href="/site.webmanifest"/>
			<link rel="alternate" type="application/rss+xml" title="Conteúdos Viagate" href="/feed.xml"/>
			<link rel="alternate" type="text/plain" title="Viagate para LLMs" href="/llms.txt"/>
			<style>h1{font-size:2em}</style>
			<link rel="stylesheet" href="/assets/css/site.css"/>
			<link rel="stylesheet" href="/assets/css/industrial-tech.css"/>
			<link rel="stylesheet" href="/assets/css/risk-engine.css"/>
			<link rel="stylesheet" href="/assets/css/risk-engine-scenarios.css"/>
			<link rel="stylesheet" href="/assets/css/risk-engine-profile.css"/>
			<link rel="stylesheet" href="/assets/css/biometric-flow.css"/>
			<link rel="stylesheet" href="/assets/css/biometric-face-frame.css"/>
			<link rel="stylesheet" href="/assets/css/header-mega-menu.css"/>
			<link rel="stylesheet" href="/assets/css/tool-function-menu.css"/>
			<link rel="stylesheet" href="/assets/css/tools-catalog.css"/>
			<link rel="stylesheet" href="/assets/css/tool-visual-assets.css"/>
			<link rel="stylesheet" href="/assets/css/cargo-score-identity-hero.css"/>
			<link rel="stylesheet" href="/assets/css/cargo-score-panel-shadow.css"/>
			<link rel="stylesheet" href="/assets/css/cargo-score-process.css"/>
			<link rel="stylesheet" href="/assets/css/cargo-score-verification.css"/>
			<link rel="stylesheet" href="/assets/css/cargo-authenticator.css"/>
			<link rel="stylesheet" href="/assets/css/cargo-authenticator-gate.css"/>
			<link rel="stylesheet" href="/assets/css/cargo-truck-route.css"/>
			<link rel="stylesheet" href="/assets/css/cargo-truck-journey.css"/>
			<link rel="stylesheet" href="/assets/css/prevention-vehicle-hero.css"/>
			<script src="/assets/js/site.js" defer></script>
			<script src="/assets/js/risk-engine-profile.js" defer></script>
			<script src="/assets/js/biometric-flow.js" defer></script>
			<script src="/assets/js/biometric-face-enhance.js" defer></script>
			<script src="/assets/js/header-mega-menu.js" defer></script>
			<script src="/assets/js/cargo-score-identity-hero.js" defer></script>
			<script src="/assets/js/cargo-authenticator.js" defer></script>
			<script src="/assets/js/cargo-truck-route.js" defer></script>
			<script src="/assets/js/prevention-vehicle-hero.js" defer></script>
			if meta.Schema != "" {
				@templ.Raw("<script type=\"application/ld+json\">" + meta.Schema + "</script>")
			}
		</head>
		<body>
			<a class="skip-link" href="#main-content">Ir para o conteúdo</a>
			@Header()
			<main id="main-content">
				{ children... }
			</main>
			@Footer()
			<button class="whatsapp-trigger" type="button" aria-haspopup="dialog" aria-controls="whatsapp-dialog" data-whatsapp-open>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
					<path d="M8 8h8M8 12h5"></path>
				</svg>
				<span>WhatsApp</span>
			</button>
			<dialog class="whatsapp-dialog" id="whatsapp-dialog" aria-labelledby="whatsapp-dialog-title" data-whatsapp-dialog>
				<div class="whatsapp-dialog-card">
					<div class="whatsapp-dialog-header">
						<div>
							<span>Atendimento Viagate</span>
							<h2 id="whatsapp-dialog-title">Como podemos ajudar?</h2>
						</div>
						<form method="dialog">
							<button class="whatsapp-dialog-close" type="submit" aria-label="Fechar atendimento">×</button>
						</form>
					</div>
					<p>Escolha o canal adequado para iniciar a conversa pelo WhatsApp.</p>
					<div class="whatsapp-options">
						<a href="https://wa.me/5541988697727?text=Ol%C3%A1%21+Preciso+de+Suporte" target="_blank" rel="noopener noreferrer">
							<span class="whatsapp-option-index">01</span>
							<span><strong>Suporte ao motorista</strong><small>Atendimento direcionado para motoristas.</small></span>
							<span aria-hidden="true">↗</span>
						</a>
						<a href="https://wa.me/5541999623600?text=Ol%C3%A1%21+Gostaria+de+falar+com+o+Comercial" target="_blank" rel="noopener noreferrer">
							<span class="whatsapp-option-index">02</span>
							<span><strong>Área Comercial</strong><small>Soluções, integrações e propostas.</small></span>
							<span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</dialog>
		</body>
	</html>
}
