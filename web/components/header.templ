package components

templ Brand() {
	<a class="brand" href="/" aria-label="Viagate, página inicial">
		<img class="brand-image" src="/assets/images/logo_viagate.svg" width="1726" height="367" alt="Viagate"/>
	</a>
}

templ Header() {
	<header class="site-header">
		<div class="container header-inner">
			@Brand()
			<nav class="desktop-nav" aria-label="Navegação principal">
				<a href="/solucoes">Soluções</a>
				<a href="/integracoes/api">API</a>
				<a href="/white-label">White label</a>
				<a href="/sobre">Sobre</a>
				<a href="/blog">Conteúdos</a>
			</nav>
			<a class="button button-small desktop-cta" href="/contato">Fale com um especialista</a>
			<details class="mobile-menu">
				<summary aria-label="Abrir menu"><span></span><span></span><span></span></summary>
				<nav aria-label="Navegação para celular">
					<a href="/solucoes">Soluções</a>
					<a href="/integracoes/api">API</a>
					<a href="/white-label">White label</a>
					<a href="/sobre">Sobre</a>
					<a href="/blog">Conteúdos</a>
					<a class="button" href="/contato">Fale com um especialista</a>
				</nav>
			</details>
		</div>
	</header>
}
