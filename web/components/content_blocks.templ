package components

import "github.com/viagate/site/internal/site"

func articleImagePath(slug string) string {
	switch slug {
	case "pesquisa-cadastral-de-motoristas":
		return "/assets/images/pesquisa-cadastral-motoristas-viagate.webp"
	case "biometria-facial-no-transporte":
		return "/assets/images/biometria-facial-transporte-viagate.webp"
	case "como-reduzir-fraudes-no-frete":
		return "/assets/images/fraudes-frete-autenticacao-identidade-viagate.webp"
	default:
		return ""
	}
}

templ ArticleImage(article site.Article, className string, loading string) {
	if articleImagePath(article.Slug) != "" {
		<img class={ className } src={ articleImagePath(article.Slug) } alt={ article.ImageDescription } width="1672" height="941" loading={ loading } decoding="async"/>
	} else {
		@ImagePlaceholder(article.ImageDescription, article.ImageSize, className)
	}
}

templ ArticleCard(article site.Article) {
	<article class="article-card">
		<a href={ "/blog/" + article.Slug } aria-label={ "Ler: " + article.Title }>
			@ArticleImage(article, "article-card-cover", "lazy")
		</a>
		<div class="article-card-body">
			<div class="article-meta"><span>{ article.Category }</span><span>{ article.ReadingTime }</span></div>
			<h3><a href={ "/blog/" + article.Slug }>{ article.Title }</a></h3>
			<p>{ article.Summary }</p>
			<a class="text-link" href={ "/blog/" + article.Slug }>Ler conteúdo <span aria-hidden="true">→</span></a>
		</div>
	</article>
}

templ CallToAction(title string, text string) {
	<section class="cta-section">
		<div class="container cta-card">
			<div><span class="eyebrow eyebrow-light">Próximo passo</span><h2>{ title }</h2><p>{ text }</p></div>
			<a class="button button-light" href="/contato">Agendar demonstração</a>
		</div>
	</section>
}
