package components

templ Footer() {
	<footer class="site-footer">
		<div class="container footer-grid">
			<div class="footer-intro">
				@Brand()
				<p>Tecnologia para decisões críticas em pesquisa cadastral, identidade, prevenção e gestão logística no transporte.</p>
			</div>
			<div>
				<h2>Soluções</h2>
				<a href="/solucoes/pesquisa-cadastral-de-motoristas">Cargo Score</a>
				<a href="/solucoes/biometria-facial">Biometria facial</a>
				<a href="/solucoes/gestao-logistica">Cargo Truck</a>
				<a href="/integracoes/api">Integrações via API</a>
			</div>
			<div>
				<h2>Viagate</h2>
				<a href="/sobre">Sobre</a>
				<a href="/blog">Conteúdos</a>
				<a href="/contato">Contato</a>
				<a href="/llms.txt">llms.txt</a>
			</div>
			<div>
				<h2>Contato</h2>
				<a href="mailto:contato@viagate.com.br">contato@viagate.com.br</a>
				<a href="tel:+5541999623600">+55 41 99962-3600</a>
				<p>Curitiba, Paraná, Brasil</p>
			</div>
		</div>
		<div class="container footer-bottom">
			<p>© 2026 Viagate Tecnologia.</p>
			<div><a href="/termos-uso-politica-privacidade#politica-de-privacidade">Privacidade</a><a href="/termos-uso-politica-privacidade#termos-de-uso">Termos</a></div>
		</div>
	</footer>
}
