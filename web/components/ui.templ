package components

import (
	"fmt"

	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/icon"
	"github.com/viagate/site/internal/site"
)

templ Icon(name string) {
	switch name {
		case "scan-face":
			@icon.ScanFace(icon.Props{Class: "ui-icon"})
		case "shield-check":
			@icon.ShieldCheck(icon.Props{Class: "ui-icon"})
		case "truck":
			@icon.Truck(icon.Props{Class: "ui-icon"})
		case "route":
			@icon.Route(icon.Props{Class: "ui-icon"})
		case "map-pinned":
			@icon.MapPinned(icon.Props{Class: "ui-icon"})
		case "package-check":
			@icon.PackageCheck(icon.Props{Class: "ui-icon"})
		case "map":
			@icon.Map(icon.Props{Class: "ui-icon"})
		case "coffee":
			@icon.Coffee(icon.Props{Class: "ui-icon"})
		case "car-front":
			@icon.CarFront(icon.Props{Class: "ui-icon"})
		case "code":
			@icon.Code(icon.Props{Class: "ui-icon"})
		case "braces":
			@icon.Braces(icon.Props{Class: "ui-icon"})
		case "workflow":
			@icon.Workflow(icon.Props{Class: "ui-icon"})
		case "database":
			@icon.Database(icon.Props{Class: "ui-icon"})
		case "palette":
			@icon.Palette(icon.Props{Class: "ui-icon"})
		case "refresh-cw":
			@icon.RefreshCw(icon.Props{Class: "ui-icon"})
		case "user-check":
			@icon.UserCheck(icon.Props{Class: "ui-icon"})
		case "badge-check":
			@icon.BadgeCheck(icon.Props{Class: "ui-icon"})
		case "sliders":
			@icon.SlidersHorizontal(icon.Props{Class: "ui-icon"})
		case "history":
			@icon.History(icon.Props{Class: "ui-icon"})
		case "map-pin":
			@icon.MapPin(icon.Props{Class: "ui-icon"})
		case "globe":
			@icon.Globe(icon.Props{Class: "ui-icon"})
		case "smartphone":
			@icon.Smartphone(icon.Props{Class: "ui-icon"})
		case "send":
			@icon.Send(icon.Props{Class: "ui-icon"})
		case "link":
			@icon.Link(icon.Props{Class: "ui-icon"})
		case "file-warning":
			@icon.FileExclamationPoint(icon.Props{Class: "ui-icon"})
		case "receipt":
			@icon.Receipt(icon.Props{Class: "ui-icon"})
		case "triangle-alert":
			@icon.TriangleAlert(icon.Props{Class: "ui-icon"})
		case "bell-ring":
			@icon.BellRing(icon.Props{Class: "ui-icon"})
		default:
			@icon.CircleCheck(icon.Props{Class: "ui-icon"})
	}
}

templ CommandCenter() {
	<figure class="command-center" aria-label="Interface conceitual de controle de risco e liberação de viagem" data-risk-engine>
		<div class="console-bar">
			<div class="console-brand"><span class="console-mark"></span><span>VIAGATE / RISK ENGINE</span></div>
			<div class="console-live"><span></span> operação conectada</div>
		</div>
		<div class="console-main">
			<div class="operational-timeline">
				<div class="timeline-heading">
					<div><span>PROCESSO OPERACIONAL</span><strong>Validação em tempo real</strong></div>
					<p><i></i><span>10 etapas</span></p>
				</div>
				<ol class="process-flow" data-process-flow>
					@ProcessStep("01", "Recebendo dados")
					@ProcessStep("02", "Gerando link")
					@ProcessStep("03", "Validando biometria")
					@ProcessStep("04", "Validando localização")
					@ProcessStep("05", "Analisando dados pessoais")
					@ProcessStep("06", "Validando CNH")
					@ProcessStep("07", "Analisando processos")
					@ProcessStep("08", "Analisando veículo")
					@ProcessStep("09", "Gerando liberação")
					@ProcessStep("10", "Liberação concluída")
				</ol>
			</div>
			<div class="console-status">
				<div class="status-heading"><span>SINAIS</span><small>sincronizados</small></div>
				@SignalState("biometry", "IDENTIDADE", "Aguardando biometria", "Validando biometria", "Biometria validada", "scan-face")
				@SignalState("location", "LOCALIZAÇÃO", "Aguardando localização", "Validando localização", "Localização confirmada", "map-pin")
				@SignalState("data", "CADASTRO", "Aguardando dados", "Analisando dados", "Dados validados", "database")
				@SignalState("documents", "DOCUMENTAÇÃO", "Aguardando documento", "Validando CNH", "Documentação validada", "badge-check")
				@SignalState("risk", "CONTEXTO DE RISCO", "Aguardando análise", "Analisando contexto", "Risco analisado", "shield-check")
				@SignalState("release", "DECISÃO", "Aguardando liberação", "Gerando liberação", "Liberado para viagem", "user-check")
			</div>
		</div>
		<figcaption>Fluxo conceitual de validação e liberação operacional</figcaption>
	</figure>
}

templ ProcessStep(index string, label string) {
	<li class="process-step" data-process-step>
		<span class="process-index">{ index }</span>
		<div class="process-step-body">
			<strong>{ label }</strong>
			<span class="process-progress" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
		</div>
		<span class="process-result" aria-hidden="true">✓</span>
	</li>
}

templ SignalState(key string, category string, pending string, active string, complete string, iconName string) {
	<div class="signal-state" data-signal-state={ key } data-pending-label={ pending } data-active-label={ active } data-complete-label={ complete }>
		<span class="signal-state-icon">
			<i aria-hidden="true"></i>
			@Icon(iconName)
		</span>
		<div><small>{ category }</small><strong data-signal-label>{ pending }</strong></div>
		<span class="signal-state-check" aria-hidden="true">✓</span>
	</div>
}

templ BiometricCore() {
	<figure class="biometric-core" aria-label="Representação conceitual de biometria e análise cadastral">
		<div class="core-orbit core-orbit-one"></div>
		<div class="core-orbit core-orbit-two"></div>
		<div class="core-signal core-signal-left">
			<span>
				@Icon("user-check")
			</span><small>Cadastro</small><strong>Estruturado</strong>
		</div>
		<div class="core-signal core-signal-right">
			<span>
				@Icon("shield-check")
			</span><small>Política</small><strong>Aplicada</strong>
		</div>
		<div class="biometric-device">
			<div class="device-speaker"></div>
			<div class="device-screen">
				<span class="screen-label">VALIDAÇÃO EM ANDAMENTO</span>
				<div class="face-stage">
					<div class="face-ring face-ring-static"></div>
					<div class="face-ring face-ring-active"></div>
					<div class="face-icon">
						@Icon("scan-face")
					</div>
					<div class="scan-line"></div>
				</div>
				<div class="device-progress"><span></span></div>
				<div class="device-checks"><span>presença</span><span>identidade</span><span>contexto</span></div>
			</div>
		</div>
		<figcaption>Fluxo conceitual de validação biométrica</figcaption>
	</figure>
}

templ ApiConsole() {
	<figure class="api-console" aria-label="Exemplo conceitual de integração com a API Viagate">
		<div class="api-console-bar"><span></span><span></span><span></span><strong>POST /v1/validations</strong></div>
		<pre>
			<code>
				<span class="code-line"><span class="code-muted">{ "{" }</span></span>
				<span class="code-line code-indent"><span class="code-key">"workflow"</span>: <span class="code-value">"driver_validation"</span>,</span>
				<span class="code-line code-indent"><span class="code-key">"checks"</span>: [</span>
				<span class="code-line code-indent-double"><span class="code-value">"identity"</span>,</span>
				<span class="code-line code-indent-double"><span class="code-value">"biometry"</span>,</span>
				<span class="code-line code-indent-double"><span class="code-value">"registry"</span></span>
				<span class="code-line code-indent">],</span>
				<span class="code-line code-indent"><span class="code-key">"callback"</span>: <span class="code-value">"/events/status"</span></span>
				<span class="code-line"><span class="code-muted">{ "}" }</span></span>
			</code>
		</pre>
		<div class="api-result"><span><i></i> 202 ACCEPTED</span><small>trace vg_84f1...c29</small></div>
		<figcaption>Exemplo ilustrativo; endpoints dependem da documentação contratada.</figcaption>
	</figure>
}

templ PowerSolutionCard(solution site.Solution, index int) {
	<article class="power-card">
		<div class="power-card-top"><span>{ solution.Name }</span><strong>{ fmt.Sprintf("%02d", index) }</strong></div>
		<div class="power-card-icon">
			@Icon(solution.Icon)
		</div>
		<h3>{ solution.ShortName }</h3>
		<p>{ solution.Summary }</p>
		<a href={ solutionPath(solution) }>Conhecer solução <span aria-hidden="true">↗</span></a>
		<div class="power-card-grid" aria-hidden="true"></div>
	</article>
}

templ CargoScoreNetworkPanel() {
	<figure class="solution-signal-panel score-network-panel" aria-label="Rede conceitual do Cargo Score reunindo fontes cadastrais em uma análise rastreável">
		<div class="signal-panel-grid" aria-hidden="true"></div>
		<div class="signal-panel-top">
			<span><i></i> VIAGATE / CARGO SCORE</span>
			<small>ANÁLISE EM PROCESSAMENTO</small>
		</div>
		<div class="score-network-stage">
			<svg class="score-network-lines" viewBox="0 0 600 360" preserveAspectRatio="none" aria-hidden="true" focusable="false">
				<g class="score-network-paths score-network-paths-base">
					<path d="M102 66 L300 180"></path>
					<path d="M76 180 L300 180"></path>
					<path d="M102 294 L300 180"></path>
					<path d="M498 66 L300 180"></path>
					<path d="M524 180 L300 180"></path>
					<path d="M498 294 L300 180"></path>
					<path d="M102 66 L76 180 L102 294"></path>
					<path d="M498 66 L524 180 L498 294"></path>
				</g>
				<g class="score-network-paths score-network-paths-flow">
					<path d="M102 66 L300 180"></path>
					<path d="M76 180 L300 180"></path>
					<path d="M102 294 L300 180"></path>
					<path d="M498 66 L300 180"></path>
					<path d="M524 180 L300 180"></path>
					<path d="M498 294 L300 180"></path>
				</g>
			</svg>
			<div class="score-network-node score-network-node-biometry">
				<span>@Icon("scan-face")
</span>
				<p><small>IDENTIDADE</small><strong>Biometria</strong></p><i></i>
			</div>
			<div class="score-network-node score-network-node-phone">
				<span>@Icon("smartphone")
</span>
				<p><small>CONTATO</small><strong>Telefone</strong></p><i></i>
			</div>
			<div class="score-network-node score-network-node-license">
				<span>@Icon("badge-check")
</span>
				<p><small>DOCUMENTO</small><strong>CNH</strong></p><i></i>
			</div>
			<div class="score-network-node score-network-node-registry">
				<span>@Icon("route")
</span>
				<p><small>REGISTRO</small><strong>ANTT</strong></p><i></i>
			</div>
			<div class="score-network-node score-network-node-courts">
				<span>@Icon("file-warning")
</span>
				<p><small>CONTEXTO</small><strong>Processos</strong></p><i></i>
			</div>
			<div class="score-network-node score-network-node-vehicle">
				<span>@Icon("car-front")
</span>
				<p><small>CADASTRO</small><strong>Veículo</strong></p><i></i>
			</div>
			<div class="score-engine">
				<div class="score-engine-ring score-engine-ring-outer" aria-hidden="true"></div>
				<div class="score-engine-ring score-engine-ring-inner" aria-hidden="true"></div>
				<span>@Icon("user-check")
</span>
				<small>CARGO</small>
				<strong>SCORE</strong>
			</div>
		</div>
		<div class="score-network-result">
			<span class="score-result-icon">@Icon("shield-check")
</span>
			<div><small>RESULTADO CONSOLIDADO</small><strong>Análise rastreável para decisão segura</strong></div>
			<span class="score-result-privacy"><i></i> EVIDÊNCIAS PARA GOVERNANÇA LGPD</span>
		</div>
		<figcaption>Fluxo conceitual — fontes, critérios e evidências dependem dos módulos contratados.</figcaption>
	</figure>
}

templ SolutionSignalPanel(solution site.Solution) {
	<figure class="solution-signal-panel" aria-label={ "Representação conceitual da solução " + solution.ShortName }>
		<div class="signal-panel-grid" aria-hidden="true"></div>
		<div class="signal-panel-top">
			<span><i></i> VIAGATE / { solution.ShortName }</span>
			<small>SISTEMA OPERACIONAL</small>
		</div>
		<div class="signal-panel-core">
			<div class="signal-radar signal-radar-one"></div>
			<div class="signal-radar signal-radar-two"></div>
			<div class="signal-core-icon">
				@Icon(solution.Icon)
			</div>
		</div>
		<div class="signal-panel-checks">
			for index, feature := range solution.Features {
				if index < 3 {
					<div>
						<span>
							@Icon(feature.Icon)
						</span>
						<p><small>SINAL { fmt.Sprintf("%02d", index + 1) }</small><strong>{ feature.Title }</strong></p><i></i>
					</div>
				}
			}
		</div>
		<figcaption>Visualização conceitual — a interface final depende dos módulos contratados.</figcaption>
	</figure>
}

templ ImagePlaceholder(description string, size string, className string) {
	<div class={ "image-placeholder " + className } role="img" aria-label={ description + " Tamanho recomendado: " + size }>
		<span class="placeholder-icon" aria-hidden="true">▧</span>
		<strong>Imagem sugerida</strong>
		<span>{ description }</span>
		<small>{ size }</small>
	</div>
}

templ SectionHeading(kicker string, title string, text string) {
	<div class="section-heading">
		if kicker != "" {
			<span class="eyebrow">{ kicker }</span>
		}
		<h2>{ title }</h2>
		if text != "" {
			<p>{ text }</p>
		}
	</div>
}

templ SolutionCard(solution site.Solution) {
	@card.Card(card.Props{Class: "solution-card"}) {
		<div class="icon-tile">
			@Icon(solution.Icon)
		</div>
		<p class="card-kicker">{ solution.Name }</p>
		<h3>{ solution.ShortName }</h3>
		<p>{ solution.Summary }</p>
		<a class="text-link" href={ solutionPath(solution) }>Conhecer solução <span aria-hidden="true">→</span></a>
	}
}

func solutionPath(solution site.Solution) string {
	switch solution.Slug {
	case "api":
		return "/integracoes/api"
	case "white-label":
		return "/white-label"
	default:
		return "/solucoes/" + solution.Slug
	}
}