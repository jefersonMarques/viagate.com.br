APP_ENV=development
APP_ADDRESS=:8090
SITE_URL=https://viagate.com.br

# Google integrations
# Prefer GOOGLE_TAG_MANAGER_ID in production. Configure GA4, Google Ads and future tags inside GTM.
# GOOGLE_ANALYTICS_ID is kept as a direct fallback and is ignored when GTM is configured.
GOOGLE_TAG_MANAGER_ID=
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

BREVO_API_KEY=
BREVO_CONTACT_NAME=ViaGate
BREVO_CONTACT_SUBJECT=Contato via site
BREVO_CONTACT_SENDER=no_reply@viagate.com.br
CONTACT_EMAIL=contato@viagate.com.br

CONTACT_WEBHOOK_URL=
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
